<Window x:Class="VictusControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VictusControl.App.Controls"
        Title="Victus Control" Height="800" Width="1240"
        MinHeight="640" MinWidth="1000"
        Icon="victus.ico"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Icon geometry, one stroke language across the whole nav -->
        <Geometry x:Key="IcoVitals">M3,12 L7,12 L9,7 L12,17 L15,10 L17,12 L21,12</Geometry>
        <Geometry x:Key="IcoPerformance">M4,20 L4,10 M10,20 L10,4 M16,20 L16,13 M22,20 L22,7</Geometry>
        <Geometry x:Key="IcoGames">M7,12 L11,12 M9,10 L9,14 M16,11 L16.01,11 M18,13 L18.01,13 M6.5,7 L17.5,7 A5,5 0 0 1 17.5,17 L6.5,17 A5,5 0 0 1 6.5,7 Z</Geometry>
        <Geometry x:Key="IcoSettings">M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 Z M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12</Geometry>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,6">
                        <Image Source="victus.ico" Width="26" Height="26"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="VICTUS CONTROL" VerticalAlignment="Center" Margin="11,0,0,0"
                                   FontFamily="{StaticResource DisplayFace}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <!-- Quit lives at the foot, since closing only hides to tray -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,14"/>
                        <DockPanel>
                            <TextBlock Text="Light theme" Style="{StaticResource Label}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ThemeSwitch" Style="{StaticResource ThemeToggle}"
                                          HorizontalAlignment="Right" Checked="OnThemeChanged"
                                          Unchecked="OnThemeChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="ElevationNote" Style="{StaticResource LabelMuted}"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="MONITOR" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavVitals" Content="System Vitals" IsChecked="True"
                                     Style="{StaticResource NavButton}" Tag="{StaticResource IcoVitals}"
                                     Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavGames" Content="Games"
                                     Style="{StaticResource NavButton}" Tag="{StaticResource IcoGames}"
                                     Checked="OnNavChanged"/>

                        <TextBlock Text="CONTROL" Style="{StaticResource NavSection}"/>
                        <RadioButton x:Name="NavPerformance" Content="Performance Control"
                                     Style="{StaticResource NavButton}" Tag="{StaticResource IcoPerformance}"
                                     Checked="OnNavChanged"/>
                        <RadioButton x:Name="NavSettings" Content="Settings"
                                     Style="{StaticResource NavButton}" Tag="{StaticResource IcoSettings}"
                                     Checked="OnNavChanged"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Content ===== -->
            <DockPanel Grid.Column="1">

                <!-- Title bar -->
                <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource WindowBg}"
                        MouseLeftButtonDown="OnTitleBarDrag">
                    <Grid>
                        <TextBlock x:Name="PageHeading" Text="System Vitals" Margin="24,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource CardTitle}"
                                   FontSize="14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ChromeButton}" Click="OnMinimize"
                                    Tag="M0,5 L10,5" ToolTip="Minimise"/>
                            <Button Style="{StaticResource ChromeButton}" Click="OnMaximize"
                                    Tag="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" ToolTip="Maximise"/>
                            <Button Style="{StaticResource CloseButton}" Click="OnClose"
                                    Tag="M0,0 L10,10 M10,0 L0,10" ToolTip="Close to tray"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status strip -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0"
                        Padding="24,9">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Label}" Text="Ready."/>
                </Border>

                <Grid>
                    <!-- ========== SYSTEM VITALS ========== -->
                    <ScrollViewer x:Name="PageVitals" VerticalScrollBarVisibility="Auto"
                                  Padding="24,6,24,24">
                        <StackPanel>
                            <!-- Top row: the four headline gauges -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="GPU" Style="{StaticResource CardTitle}"/>
                                        <c:RingGauge x:Name="GpuRing" Height="150" Margin="0,16,0,10"
                                                     Thickness="8" FontSize="24"
                                                     FontFamily="{StaticResource DisplayFace}"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     CaptionBrush="{DynamicResource TextSecondary}"
                                                     TrackBrush="{DynamicResource Track}"
                                                     ArcBrush="{DynamicResource AccentRamp}"
                                                     Caption="GPU Utilization"/>
                                        <!-- Severity inverts instead of changing colour -->
                                        <Border x:Name="GpuTempBox" HorizontalAlignment="Left"
                                                Padding="6,2" CornerRadius="3" Background="Transparent">
                                            <TextBlock x:Name="GpuTempText" Text="--" FontSize="18"
                                                       FontFamily="{StaticResource DisplayFace}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextOptions.TextRenderingMode="Aliased"/>
                                        </Border>
                                        <TextBlock Text="GPU Temperature" Style="{StaticResource LabelMuted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource CardTitle}"/>
                                        <c:RingGauge x:Name="CpuRing" Height="150" Margin="0,16,0,10"
                                                     Thickness="8" FontSize="24"
                                                     FontFamily="{StaticResource DisplayFace}"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     CaptionBrush="{DynamicResource TextSecondary}"
                                                     TrackBrush="{DynamicResource Track}"
                                                     ArcBrush="{DynamicResource AccentRamp}"
                                                     Caption="CPU Utilization"/>
                                        <Border x:Name="CpuTempBox" HorizontalAlignment="Left"
                                                Padding="6,2" CornerRadius="3" Background="Transparent">
                                            <TextBlock x:Name="CpuTempText" Text="--" FontSize="18"
                                                       FontFamily="{StaticResource DisplayFace}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextOptions.TextRenderingMode="Aliased"/>
                                        </Border>
                                        <TextBlock Text="CPU Temperature" Style="{StaticResource LabelMuted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="RAM" Style="{StaticResource CardTitle}"/>
                                        <c:RingGauge x:Name="RamRing" Height="150" Margin="0,16,0,10"
                                                     Thickness="8" FontSize="24"
                                                     FontFamily="{StaticResource DisplayFace}"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     CaptionBrush="{DynamicResource TextSecondary}"
                                                     TrackBrush="{DynamicResource Track}"
                                                     ArcBrush="{DynamicResource AccentRamp}"
                                                     Caption="RAM Utilization"/>
                                        <TextBlock x:Name="RamText" Text="--" Style="{StaticResource Label}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="STORAGE" Style="{StaticResource CardTitle}"/>
                                        <StackPanel x:Name="DrivesPanel" Margin="0,20,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Second row -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fans: the thing a vendor hub buries and this app exists for -->
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="FANS" Style="{StaticResource CardTitle}"/>
                                        <StackPanel Margin="0,18,0,0">
                                            <TextBlock x:Name="CpuFanText" Text="--"
                                                       Style="{StaticResource StatBig}" FontSize="30"/>
                                            <TextBlock Text="CPU fan · max 5400 rpm"
                                                       Style="{StaticResource LabelMuted}"/>
                                            <TextBlock x:Name="GpuFanText" Text="--"
                                                       Style="{StaticResource StatBig}" FontSize="30"
                                                       Margin="0,14,0,0"/>
                                            <TextBlock Text="GPU fan · max 5200 rpm"
                                                       Style="{StaticResource LabelMuted}"/>
                                        </StackPanel>
                                        <Border Margin="0,18,0,0" CornerRadius="4" Padding="10,7"
                                                BorderBrush="{DynamicResource Stroke}" BorderThickness="2">
                                            <DockPanel>
                                                <TextBlock Text="Thermal throttle"
                                                           Style="{StaticResource LabelMuted}"
                                                           VerticalAlignment="Center"/>
                                                <Border x:Name="ThrottleBox" HorizontalAlignment="Right"
                                                        Padding="7,2" CornerRadius="3"
                                                        Background="Transparent">
                                                    <TextBlock x:Name="ThrottleText" Text="--"
                                                               FontFamily="{StaticResource DisplayFace}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextOptions.TextRenderingMode="Aliased"/>
                                                </Border>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Network -->
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="NETWORK" Style="{StaticResource CardTitle}"/>
                                        <StackPanel Margin="0,18,0,0">
                                            <TextBlock x:Name="DownText" Text="0.0"
                                                       Style="{StaticResource StatBig}" FontSize="30"/>
                                            <TextBlock Text="Download Mbps" Style="{StaticResource LabelMuted}"/>
                                            <TextBlock x:Name="UpText" Text="0.0"
                                                       Style="{StaticResource StatBig}" FontSize="30"
                                                       Margin="0,14,0,0"/>
                                            <TextBlock Text="Upload Mbps" Style="{StaticResource LabelMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Top processes -->
                                <Border Grid.Column="4" Style="{StaticResource Card}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="TOP PROCESSES"
                                                   Style="{StaticResource CardTitle}"/>
                                        <Grid DockPanel.Dock="Top" Margin="0,16,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="NAME" Style="{StaticResource LabelMuted}"/>
                                            <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource LabelMuted}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="GPU" Style="{StaticResource LabelMuted}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="RAM" Style="{StaticResource LabelMuted}"
                                                       TextAlignment="Right"/>
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1"
                                                Background="{DynamicResource Stroke}"/>
                                        <ItemsControl x:Name="ProcessList" Margin="0,4,0,0"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== GAMES ========== -->
                    <ScrollViewer x:Name="PageGames" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="24,6,24,24">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="RECENTLY PLAYED" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource LabelMuted}" Margin="0,4,0,0"
                                                   Text="Detected automatically by watching which programs drive the graphics card."/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Content="Clear history" Style="{StaticResource GhostButton}"
                                            Click="OnClearGames"/>
                                </DockPanel>
                            </Border>

                            <ItemsControl x:Name="GamesList" Margin="0,16,0,0"/>

                            <Border x:Name="GamesEmpty" Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="No games detected yet"
                                               Style="{StaticResource CardTitle}" FontSize="15"/>
                                    <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Text="Play something with Victus Control running and it will appear here. Detection starts from now — sessions played before this was installed cannot be recovered."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== PERFORMANCE CONTROL ========== -->
                    <ScrollViewer x:Name="PagePerformance" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="24,6,24,24">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="FAN MODE" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource LabelMuted}" Margin="0,4,0,16"
                                               Text="Hands the fans to a BIOS curve. At idle the change may not be audible until the machine warms up."/>
                                    <WrapPanel>
                                        <RadioButton x:Name="ModeDefault" Content="Default" GroupName="fan"
                                                     Style="{StaticResource ModeButton}" Click="OnFanModeDefault"/>
                                        <RadioButton x:Name="ModePerformance" Content="Performance" GroupName="fan"
                                                     Style="{StaticResource ModeButton}" Click="OnFanModePerformance"/>
                                        <RadioButton x:Name="ModeCool" Content="Cool" GroupName="fan"
                                                     Style="{StaticResource ModeButton}" Click="OnFanModeCool"/>
                                        <RadioButton x:Name="ModeQuiet" Content="Quiet" GroupName="fan"
                                                     Style="{StaticResource ModeButton}" Click="OnFanModeQuiet"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="MANUAL FAN SPEED" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource LabelMuted}" Margin="0,4,0,18"
                                               Text="Overrides the curve. The BIOS reclaims the fans after a few seconds."/>

                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock DockPanel.Dock="Left" Text="CPU" Width="46"
                                                   Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" x:Name="CpuSliderText" Width="90"
                                                   Style="{StaticResource Label}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Text="0 rpm"/>
                                        <Slider x:Name="CpuFanSlider" Minimum="0" Maximum="54" Margin="12,0"
                                                Style="{StaticResource AccentSlider}"
                                                ValueChanged="OnFanSliderChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,18">
                                        <TextBlock DockPanel.Dock="Left" Text="GPU" Width="46"
                                                   Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" x:Name="GpuSliderText" Width="90"
                                                   Style="{StaticResource Label}" TextAlignment="Right"
                                                   VerticalAlignment="Center" Text="0 rpm"/>
                                        <Slider x:Name="GpuFanSlider" Minimum="0" Maximum="52" Margin="12,0"
                                                Style="{StaticResource AccentSlider}"
                                                ValueChanged="OnFanSliderChanged"/>
                                    </DockPanel>

                                    <WrapPanel>
                                        <Button Content="Apply level" Style="{StaticResource GhostButton}"
                                                Margin="0,0,10,0" Click="OnApplyManualFan"/>
                                        <ToggleButton x:Name="MaxFanButton" Content="Max fan"
                                                      Click="OnMaxFanToggle" Cursor="Hand"
                                                      FontFamily="{StaticResource DisplayFace}"
                                                      FontSize="10"
                                                      TextOptions.TextRenderingMode="Aliased">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bd" CornerRadius="7" Padding="13,8"
                                                            Background="{DynamicResource Paper}"
                                                            BorderBrush="{DynamicResource Stroke}"
                                                            BorderThickness="2" SnapsToDevicePixels="True">
                                                        <ContentPresenter x:Name="Cp"
                                                                          TextElement.Foreground="{DynamicResource TextPrimary}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Dither1}"/>
                                                        </Trigger>
                                                        <!-- Held on: inverted, the only highlight this world has -->
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource Ink}"/>
                                                            <Setter TargetName="Cp"
                                                                    Property="TextElement.Foreground"
                                                                    Value="{DynamicResource Paper}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="GRAPHICS POWER" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource LabelMuted}" Margin="0,4,0,16"
                                               Text="How much power the graphics chip is allowed to draw."/>
                                    <WrapPanel>
                                        <RadioButton x:Name="PowerMin" Content="Minimum" GroupName="power"
                                                     Style="{StaticResource ModeButton}" Click="OnGpuPowerMin"/>
                                        <RadioButton x:Name="PowerMed" Content="Medium" GroupName="power"
                                                     Style="{StaticResource ModeButton}" Click="OnGpuPowerMed"/>
                                        <RadioButton x:Name="PowerMax" Content="Maximum" GroupName="power"
                                                     Style="{StaticResource ModeButton}" Click="OnGpuPowerMax"/>
                                    </WrapPanel>

                                    <TextBlock Text="GRAPHICS MODE" Style="{StaticResource CardTitle}"
                                               Margin="0,22,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <RadioButton x:Name="GpuHybridButton" Content="Hybrid" GroupName="gpumode"
                                                     Style="{StaticResource ModeButton}" Click="OnGpuModeHybrid"/>
                                        <RadioButton x:Name="GpuDiscreteButton" Content="Discrete" GroupName="gpumode"
                                                     Style="{StaticResource ModeButton}" Click="OnGpuModeDiscrete"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="GpuModeNote" Style="{StaticResource LabelMuted}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ========== SETTINGS ========== -->
                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="24,6,24,24">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="ABOUT" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Text="Victus Control talks to the same HP BIOS interface OMEN Gaming Hub uses, without the ads or the background service suite. Closing the window keeps it running in the notification area so your fan and power settings stay applied."/>
                                    <TextBlock x:Name="AboutDetail" Style="{StaticResource LabelMuted}"
                                               Margin="0,14,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="HARDWARE SUPPORT" Style="{StaticResource CardTitle}"/>
                                    <StackPanel x:Name="SupportList" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
