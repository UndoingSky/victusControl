<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VictusControl.Core\VictusControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Silkscreen-Regular.ttf" />
    <Resource Include="Fonts\Silkscreen-Bold.ttf" />
    <Resource Include="Fonts\PixelifySans.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (the tray icon) lives in WinForms; there is no WPF equivalent -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>victus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="victus.ico" />
  </ItemGroup>

  <!-- UseWindowsForms adds these as global usings, which makes Button, Brush,
       UserControl and Application ambiguous against their WPF namesakes.
       TrayPresence.cs imports them explicitly instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
