<!--
  Component language, one-bit. Everything references the palette with
  DynamicResource, so the dark/light flip inverts the entire interface.

  The rules of this world: hierarchy comes from size and weight, never grey;
  shading comes from the dither ladder, never opacity; the selected or pressed
  state inverts to solid ink, which is the only "highlight" available.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Chicago role: chunky bitmap face for chrome, labels and figures.
         Silkscreen rather than the body face for numbers — Pixelify's 5 and 9
         are too alike at a glance, and misreading 52°C as 92°C is the one
         error a thermal monitor cannot afford. -->
    <FontFamily x:Key="DisplayFace">pack://application:,,,/Fonts/#Silkscreen</FontFamily>
    <!-- Geneva role: bitmap sans for sentences -->
    <FontFamily x:Key="BodyFace">pack://application:,,,/Fonts/#Pixelify Sans</FontFamily>

    <!-- ===== Type ===== -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFace}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- No grey exists, so "muted" is smaller rather than fainter -->
    <Style x:Key="LabelMuted" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="9"/>
    </Style>

    <Style x:Key="StatBig" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- ===== Card ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===== Sidebar navigation ===== -->

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10,2"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,9"
                            BorderBrush="Transparent" BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Ico" Grid.Column="0" Width="16" Height="16"
                                  Stretch="Uniform" HorizontalAlignment="Left"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Fill="Transparent"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  StrokeLineJoin="Miter"/>
                            <ContentPresenter x:Name="Cp" Grid.Column="1" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                        </Trigger>
                        <!-- Selected inverts, the way a HyperCard menu item does -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ink}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Paper}"/>
                            <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource Paper}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Stroke}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavSection" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="22,18,0,7"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    </Style>

    <!-- ===== Buttons ===== -->

    <Style x:Key="ModeButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="7" Padding="18,10"
                            Background="{DynamicResource Paper}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dither1}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Paper}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Paper}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dither2}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFace}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="7" Padding="13,8"
                            Background="{DynamicResource Paper}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp" HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Dither1}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ink}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Paper}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window chrome: square boxes, the classic Mac close and zoom -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15"
                                BorderBrush="{TemplateBinding Foreground}" BorderThickness="2"
                                Background="Transparent" SnapsToDevicePixels="True"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="P" Stretch="Uniform" Margin="2"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Dither2}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}"/>

    <!-- ===== Theme switch: a painted lever, not a pill ===== -->

    <Style x:Key="ThemeToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="4"
                            Background="{DynamicResource Paper}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="2"
                            SnapsToDevicePixels="True">
                        <Border x:Name="Knob" Width="18" HorizontalAlignment="Left"
                                Margin="2" Background="{DynamicResource Ink}"
                                CornerRadius="2" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Dither1}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderThickness" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbar ===== -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{DynamicResource Dither1}"
                            BorderBrush="{DynamicResource Stroke}" BorderThickness="2,0,0,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Paper}"
                                                    BorderBrush="{DynamicResource Stroke}"
                                                    BorderThickness="2" SnapsToDevicePixels="True"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider: a ruled channel with a painted block ===== -->

    <Style x:Key="AccentSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26" VerticalAlignment="Center">
                        <Border Height="14" VerticalAlignment="Center"
                                Background="{DynamicResource Paper}"
                                BorderBrush="{DynamicResource Stroke}" BorderThickness="2"
                                SnapsToDevicePixels="True"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="14" VerticalAlignment="Center"
                                                    Background="{DynamicResource Dither2}"
                                                    BorderBrush="{DynamicResource Stroke}"
                                                    BorderThickness="2" SnapsToDevicePixels="True"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="16" Height="26"
                                                    Background="{DynamicResource Paper}"
                                                    BorderBrush="{DynamicResource Stroke}"
                                                    BorderThickness="2" CornerRadius="2"
                                                    SnapsToDevicePixels="True">
                                                <Rectangle Width="2" Fill="{DynamicResource Ink}"
                                                           HorizontalAlignment="Center" Margin="0,4"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
